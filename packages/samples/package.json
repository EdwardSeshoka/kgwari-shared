{
  "name": "@edwardseshoka/samples",
  "version": "14.4.0",
  "description": "Morara sample data and contract factories.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdwardSeshoka/kgwari-shared.git",
    "directory": "packages/samples"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/features/catalog/index.d.ts",
      "default": "./dist/features/catalog/index.js"
    },
    "./collections": {
      "types": "./dist/features/collections/index.d.ts",
      "default": "./dist/features/collections/index.js"
    },
    "./provenance": {
      "types": "./dist/features/provenance/index.d.ts",
      "default": "./dist/features/provenance/index.js"
    },
    "./editorial": {
      "types": "./dist/features/editorial/index.d.ts",
      "default": "./dist/features/editorial/index.js"
    },
    "./events": {
      "types": "./dist/features/events/index.d.ts",
      "default": "./dist/features/events/index.js"
    },
    "./social": {
      "types": "./dist/features/social/index.d.ts",
      "default": "./dist/features/social/index.js"
    },
    "./search": {
      "types": "./dist/features/search/index.d.ts",
      "default": "./dist/features/search/index.js"
    },
    "./discover": {
      "types": "./dist/features/discover/index.d.ts",
      "default": "./dist/features/discover/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@edwardseshoka/contracts": "^10.0.1"
  },
  "scripts": {
    "prebuild": "npm run build --workspace @edwardseshoka/contracts",
    "build": "rm -rf dist && tsc -p tsconfig.json && rsync -am --include='*/' --include='*.json' --exclude='*' src/ dist/",
    "prelint": "npm run build --workspace @edwardseshoka/contracts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node --test",
    "pretypecheck": "npm run build --workspace @edwardseshoka/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:seeds": "node generator/index.mjs",
    "check:seeds": "node generator/index.mjs --check"
  },
  "test": null
}
