      "saveCount": 340
    },
    "estateVoice": {
      "headline": {
        "source": "negotiated",
        "text": "A Bordeaux blend that argues with its own reputation.",
        "languageTag": "en"
      },
      "standfirst": {
        "source": "negotiated",
        "text": "Dryland vines on decomposed granite, whole-berry into open concrete, eighteen months in old French oak.",
        "languageTag": "en"
      },
      "essay": [
        {
          "source": "negotiated",
          "text": "The fruit comes off a single block on the Stellenbosch side of the estate, planted long before anyone was picking for acid, and never trellised \u2014 so the vines carry their own canopy and ripen slowly in their own shade.",
          "languageTag": "en"
        },
        {
          "source": "negotiated",
          "text": "The structure is where the estate\u2019s hand shows. Tannin is fine-grained rather than grippy, and the alcohol never announces itself.",
          "languageTag": "en"
        }
      ],
      "bylineName": {
        "source": "canonical",
        "text": "Anele Mokoena"
      },
      "bylineRoleKey": "role.cellarmaster",
      "quote": {
        "source": "negotiated",
        "text": "We stopped picking for colour in 2011. The moment we started picking for acid, the vineyard told us what it actually was.",
        "languageTag": "en"
      },
