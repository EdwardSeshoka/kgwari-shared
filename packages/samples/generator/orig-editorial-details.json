    "title": "Six vintages, one afternoon in the Meerlust cellar.",
    "titleLanguage": "en",
    "standfirst": {
      "source": "negotiated",
      "text": "The estate opens a vertical it does not usually pour, and answers questions about the years it would rather forget.",
      "languageTag": "en"
    },
    "body": [
      {
        "source": "negotiated",
        "text": "Six vintages, poured in the room they were made in, in the order the cellarmaster thinks they should be met rather than the order they were picked.",
        "languageTag": "en"
      },
      {
        "source": "negotiated",
        "text": "The 2015 and the 2018 sit next to each other on purpose. One is the warm year everybody bought and the other is the cool year almost nobody did.",
        "languageTag": "en"
      }
    ],
